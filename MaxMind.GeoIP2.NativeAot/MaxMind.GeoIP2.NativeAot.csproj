<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <Target Name="RequirePackageVersion" BeforeTargets="PrepareForPublish"
          Condition="'$(GeoIP2PackageVersion)' == ''">
    <Error Text="Set GeoIP2PackageVersion to the package under test, or run dev-bin/test-native-aot.sh." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../MaxMind.GeoIP2/MaxMind.GeoIP2.csproj"
                      Condition="'$(GeoIP2PackageVersion)' == ''" />
    <PackageReference Include="MaxMind.GeoIP2" Version="$(GeoIP2PackageVersion)"
                      Condition="'$(GeoIP2PackageVersion)' != ''" />
    <Compile Include="../MaxMind.GeoIP2.UnitTests/ResponseHelper.cs" Link="ResponseHelper.cs" />
    <TestDatabase Include="GeoIP2-City-Test.mmdb" />
    <None Include="@(TestDatabase->'../MaxMind.GeoIP2.UnitTests/TestData/MaxMind-DB/test-data/%(Identity)')"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
