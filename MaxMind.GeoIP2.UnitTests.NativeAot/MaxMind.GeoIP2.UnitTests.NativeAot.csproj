<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- xUnit requires an app host. Restore it even before its props are imported. -->
    <UseAppHost>true</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <DefineConstants>$(DefineConstants);NATIVE_AOT_TESTS</DefineConstants>
    <!-- Shared tests use the library's existing friend assembly. -->
    <AssemblyName>MaxMind.GeoIP2.UnitTests</AssemblyName>
    <AssemblyOriginatorKeyFile>../MaxMind.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="RequirePackageVersion" BeforeTargets="PrepareForPublish"
          Condition="'$(GeoIP2PackageVersion)' == ''">
    <Error Text="Set GeoIP2PackageVersion to the package under test, or run dev-bin/test-native-aot.sh." />
  </Target>

  <ItemGroup>
    <PackageReference Include="xunit.v3.aot.mtp-v2" Version="4.0.0" />
    <ProjectReference Include="../MaxMind.GeoIP2/MaxMind.GeoIP2.csproj"
                      Condition="'$(GeoIP2PackageVersion)' == ''" />
    <PackageReference Include="MaxMind.GeoIP2" Version="$(GeoIP2PackageVersion)"
                      Condition="'$(GeoIP2PackageVersion)' != ''" />
    <Compile Include="../MaxMind.GeoIP2.UnitTests/**/*.cs"
             Exclude="../MaxMind.GeoIP2.UnitTests/bin/**;../MaxMind.GeoIP2.UnitTests/obj/**"
             Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
